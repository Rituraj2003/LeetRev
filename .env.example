# Server Configuration
PORT=3000

# PostgreSQL Database Connection (e.g. Neon PostgreSQL / Supabase / Render Postgres)
DATABASE_URL="postgresql://user:password@ep-example-host.region.aws.neon.tech/leetrev?sslmode=require"

# JWT Secret Key (Generate using: openssl rand -base64 32)
JWT_SECRET="your_long_random_jwt_secret_key"

# GitHub OAuth App Credentials (from GitHub Developer Settings)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="https://your-backend-domain.onrender.com/auth/github/callback"

# Frontend Origin URL (for CORS validation)
FRONTEND_URL="https://your-frontend-domain.vercel.app"

# Optional: Personal GitHub Token for dev ingestion testing
GITHUB_TOKEN=""

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY="your_google_gemini_api_key"
